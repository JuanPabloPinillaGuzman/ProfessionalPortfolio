---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../ui/layout/Section.astro';
import {
  professionalSummary,
  professionalSummaryEn,
  impactHighlights,
  impactHighlightsEn,
  siteConfig,
  englishLevel,
  englishLevelEn,
  experience,
  education,
  skillGroups,
  competencies
} from '../config/site';
import { withBase } from '../config/paths';

const cvFile = withBase(siteConfig.cvFile);
---
<MainLayout
  title="Sobre mí"
  description={siteConfig.description}
  canonicalPath="/about"
>
  <Section
    titleEs="Perfil profesional"
    titleEn="Professional profile"
    subtitleEs="Desarrollo fullstack: API en C# (.NET), bases de datos, interfaces en React + TypeScript y apps móviles."
    subtitleEn="Fullstack development: C# (.NET) APIs, databases, React + TypeScript interfaces, and mobile apps."
    className=""
  >
    <p class="max-w-3xl text-lg text-[color:var(--color-text-soft)]">
      <span class="lang-es">{professionalSummary}</span>
      <span class="lang-en">{professionalSummaryEn}</span>
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a data-motion-hover href={cvFile} target="_blank" rel="noopener" class="btn-primary">
        <span class="lang-es">Descargar CV</span>
        <span class="lang-en">Download CV</span>
      </a>
      <a data-motion-hover href={withBase('/contact')} class="btn-secondary">
        <span class="lang-es">Contactar</span>
        <span class="lang-en">Get in touch</span>
      </a>
    </div>

    <div data-motion-stagger class="mt-8 grid gap-5 md:grid-cols-3">
      <article data-motion-reveal data-motion-hover class="panel panel-hover rounded-3xl p-6">
        <h3 class="text-lg font-bold text-[color:var(--color-text)]">
          <span class="lang-es">Rol</span>
          <span class="lang-en">Role</span>
        </h3>
        <p class="mt-2 text-[color:var(--color-text-soft)]">
          <span class="lang-es">{siteConfig.roleEs}</span>
          <span class="lang-en">{siteConfig.roleEn}</span>
        </p>
      </article>
      <article data-motion-reveal data-motion-hover class="panel panel-hover rounded-3xl p-6 md:-translate-y-2">
        <h3 class="text-lg font-bold text-[color:var(--color-text)]">
          <span class="lang-es">Nivel de inglés</span>
          <span class="lang-en">English level</span>
        </h3>
        <p class="mt-2 text-[color:var(--color-text-soft)]">
          <span class="lang-es">{englishLevel}</span>
          <span class="lang-en">{englishLevelEn}</span>
        </p>
      </article>
      <article data-motion-reveal data-motion-hover class="panel panel-hover rounded-3xl p-6">
        <h3 class="text-lg font-bold text-[color:var(--color-text)]">
          <span class="lang-es">Ubicación</span>
          <span class="lang-en">Location</span>
        </h3>
        <p class="mt-2 text-[color:var(--color-text-soft)]">
          <span class="lang-es">{siteConfig.location}</span>
          <span class="lang-en">{siteConfig.locationEn}</span>
        </p>
      </article>
    </div>
  </Section>

  <Section titleEs="Experiencia" titleEn="Experience" className="">
    <div data-motion-stagger class="grid gap-5">
      {experience.map((job) => (
        <article data-motion-reveal class="panel rounded-3xl p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="text-xl font-bold text-[color:var(--color-text)]">
                <span class="lang-es">{job.roleEs}</span>
                <span class="lang-en">{job.roleEn}</span>
              </h3>
              <p class="mt-1 font-semibold text-[color:var(--color-accent)]">{job.company}</p>
            </div>
            <p class="text-sm text-[color:var(--color-text-soft)]">
              <span class="lang-es">{job.periodEs}</span>
              <span class="lang-en">{job.periodEn}</span>
            </p>
          </div>
          <p class="mt-4 italic text-[color:var(--color-text-soft)]">
            <span class="lang-es">{job.projectEs}</span>
            <span class="lang-en">{job.projectEn}</span>
          </p>
          <ul class="mt-4 space-y-3 text-[color:var(--color-text-soft)]">
            {job.highlights.map((item) => (
              <li>
                <strong class="text-[color:var(--color-text)]">
                  <span class="lang-es">{item.labelEs}:</span>
                  <span class="lang-en">{item.labelEn}:</span>
                </strong>{' '}
                <span class="lang-es">{item.copyEs}</span>
                <span class="lang-en">{item.copyEn}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <Section titleEs="Formación" titleEn="Education" className="">
    <div data-motion-stagger class="grid gap-5 md:grid-cols-2">
      {education.map((item) => (
        <article data-motion-reveal data-motion-hover class="panel panel-hover rounded-3xl p-6">
          <p class="eyebrow">{item.period}</p>
          <h3 class="mt-2 text-lg font-bold text-[color:var(--color-text)]">
            <span class="lang-es">{item.titleEs}</span>
            <span class="lang-en">{item.titleEn}</span>
          </h3>
          <p class="mt-1 text-[color:var(--color-text-soft)]">{item.institution}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section titleEs="Habilidades técnicas" titleEn="Technical skills" className="">
    <div data-motion-stagger class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map((group) => (
        <article data-motion-reveal data-motion-hover class="panel panel-hover rounded-3xl p-6">
          <h3 class="text-lg font-bold text-[color:var(--color-text)]">
            <span class="lang-es">{group.titleEs}</span>
            <span class="lang-en">{group.titleEn}</span>
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <li class="rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface-muted)] px-3 py-1 text-xs font-semibold text-[color:var(--color-accent)]">{skill}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <Section titleEs="Competencias y fortalezas" titleEn="Soft skills and strengths" className="">
    <ul class="mb-6 flex flex-wrap gap-2">
      {competencies.map((item) => (
        <li class="rounded-full border border-[color:var(--color-border)] px-4 py-2 text-sm font-semibold text-[color:var(--color-text-soft)]">
          <span class="lang-es">{item.es}</span>
          <span class="lang-en">{item.en}</span>
        </li>
      ))}
    </ul>
    <ul data-motion-stagger class="grid gap-4 md:grid-cols-3">
      {impactHighlights.map((item, index) => (
        <li data-motion-reveal data-motion-hover class="panel panel-hover rounded-3xl p-5 text-[color:var(--color-text-soft)]">
          <span class="lang-es">{item}</span>
          <span class="lang-en">{impactHighlightsEn[index]}</span>
        </li>
      ))}
    </ul>
  </Section>
</MainLayout>
